{
  "name": "memoree-sync-loop (starter)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://memoree.aurphyx.org/health",
        "options": {
          "timeout": 5000
        }
      },
      "name": "Check Memoree health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "healthy-check",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Is it down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "content": "Wire this branch to whatever you actually want on failure: Slack message, email, a push notification node, etc. Deliberately left as a No-Op so importing this workflow never accidentally emails/Slacks anyone before you've configured credentials.",
        "height": 200,
        "width": 300
      },
      "name": "Note: wire your alert here",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {},
      "name": "No-Op (replace me)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [[{ "node": "Check Memoree health", "type": "main", "index": 0 }]]
    },
    "Check Memoree health": {
      "main": [[{ "node": "Is it down?", "type": "main", "index": 0 }]]
    },
    "Is it down?": {
      "main": [[{ "node": "No-Op (replace me)", "type": "main", "index": 0 }], []]
    }
  },
  "meta": {
    "instanceId": "starter-not-yet-deployed"
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
