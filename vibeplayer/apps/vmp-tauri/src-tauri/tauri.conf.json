{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Media Player",
  "version": "0.1.0",
  "identifier": "org.aurphyx.vmp",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../.."
    },
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vibe Media Player",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Experiential media player powered by V.A.P. v3.1",
    "longDescription": "Vibe Media Player — 9-pillar V.A.P. metadata, multi-format playback, Vinyl Vibez DJ surface, v01d symbiotic packaging."
  },
  "plugins": {}
}
